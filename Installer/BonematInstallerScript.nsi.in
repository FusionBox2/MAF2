; Script generated by the HM NIS Edit Script Wizard.
; Script gene`rated by the HM NIS Edit Script Wizard.
!macro IfKeyExists ROOT MAIN_KEY KEY
push $R0
push $R1
 
!define Index 'Line${__LINE__}'
 
StrCpy $R1 "0"
 
"${Index}-Loop:"
; Check for Key
EnumRegKey $R0 ${ROOT} "${MAIN_KEY}" "$R1"
StrCmp $R0 "" "${Index}-False"
  IntOp $R1 $R1 + 1
  StrCmp $R0 "${KEY}" "${Index}-True" "${Index}-Loop"
 
"${Index}-True:"
;Return 1 if found
push "1"
goto "${Index}-End"
 
"${Index}-False:"
;Return 0 if not found
push "0"
goto "${Index}-End"
 
"${Index}-End:"
!undef Index
exch 2
pop $R0
pop $R1
!macroend
; HM NIS Edit Wizard helper defines


; HM NIS Edit Wizard helper defines

#logic incluision
!include LogicLib.nsh

!define PRODUCT_NAME "Bonemat"
!define PRODUCT_EXE_NAME "${PRODUCT_NAME}.exe"
!define PRODUCT_VERSION "@LHPBUILDER_VERSION@"
!define PRODUCT_PUBLISHER "B3C"
!define PRODUCT_WEB_SITE "http://www.biomedtown.org"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\${PRODUCT_EXE_NAME}"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_UNINST_ROOT_KEY "HKCU"

; MUI 1.67 compatible ------
!include "MUI.nsh"

; MUI Settings
!define MUI_ABORTWARNING
!define MUI_ICON "@LHPBUILDER_INSTALLER_DIR_WIN@\Bonemat.ico"
!define MUI_UNICON "@LHPBUILDER_INSTALLER_DIR_WIN@\BonematUninstall.ico"

; Welcome page
!insertmacro MUI_PAGE_WELCOME
; License page
!insertmacro MUI_PAGE_LICENSE "@LHPBUILDER_INSTALLER_DIR_WIN@\Licence.txt"
; Directory page
!insertmacro MUI_PAGE_DIRECTORY
; Instfiles page
!insertmacro MUI_PAGE_INSTFILES
; Finish page
!define MUI_FINISHPAGE_RUN "$INSTDIR\Bin\${PRODUCT_EXE_NAME}"
!insertmacro MUI_PAGE_FINISH

; Uninstaller pages
!insertmacro MUI_UNPAGE_INSTFILES

; Language files
!insertmacro MUI_LANGUAGE "English"

; MUI end ------

Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
OutFile "@LHPBUILDER_INSTALLER_EXECUTABLE_OUTPUT_DIR_WIN@\Setup_${PRODUCT_NAME}_@LHPBUILDER_VERSION@.exe"

;InstallDir "$PROGRAMFILES\LHPBuilder"
; InstallDir "$PROGRAMFILES\b3c_software\Bonemat"
InstallDir "C:\b3c_software\Bonemat"
InstallDirRegKey HKCU "${PRODUCT_DIR_REGKEY}" ""

ShowInstDetails show
ShowUnInstDetails show

Section "create product directory structure" SEC01
  ;build the fat installer?
  !define _BUILD_FAT_INSTALLER_@LHPBUILDER_BUILD_FAT_INSTALLER@
  
  ;remove old file and directories but not the data folder
  Delete "$INSTDIR\${PRODUCT_NAME}.url"
  Delete "$INSTDIR\uninst.exe"
  Delete "$INSTDIR\Bin\${PRODUCT_EXE_NAME}.manifest"
  Delete "$INSTDIR\Bin\${PRODUCT_EXE_NAME}"

  Delete "$INSTDIR\bin\C3D_Reader.dll"
  Delete "$INSTDIR\bin\LicenseAurion.dll"

  Delete "$INSTDIR\Layout\layout.mly"
  Delete "$INSTDIR\Config\Dictionary\dictionary.dic"
  Delete "$INSTDIR\Config\Dictionary\dicom3.dic"
  Delete "$INSTDIR\Splash\BonematSplash.bmp"
  
  !ifdef _BUILD_FAT_INSTALLER_ON
  IfFileExists "$INSTDIR\Python\Python25\python.exe" uninstall skipUninstall
  
  uninstall:
  ExecWait "uninstallwx.bat $INSTDIR\Python\Python25" $0
  ExecWait "uninstallpy.bat $INSTDIR\Python\Python25" $0
  
  skipUninstall:
  !endif
  
  Delete "$INSTDIR\Config\ExternalPythonVersion\PythonControl.bat"
  Delete "$INSTDIR\Config\ExternalPythonVersion\PythonScriptVersion.py"
  Delete "$INSTDIR\Config\ExternalPythonVersion\updatePythonVersion.py"

  IfFileExists "$INSTDIR\Config\ExternalPythonVersion\updatePythonVersion.pyc" fileExist fileNotExist
  
  fileExist:
     Delete "$INSTDIR\Config\ExternalPythonVersion\updatePythonVersion.pyc"
     
  fileNotExist:
  

  Delete "$SMPROGRAMS\b3c_software\Bonemat\Uninstall.lnk"
  Delete "$SMPROGRAMS\b3c_software\Bonemat\Website.lnk"
  Delete "$DESKTOP\Bonemat.lnk"
  Delete "$SMPROGRAMS\b3c_software\Bonemat\Bonemat.lnk"

  RMDir /R "$INSTDIR\VMEUploaderDownloader"
  RMDir /R "$INSTDIR\ASCIIParser"
  RMDir /R "$INSTDIR\CDBParser"
  RMDir "$INSTDIR\Splash"
  RMDir "$INSTDIR\Layout"
  RMDir "$INSTDIR\Config\Dictionary"
  RMDir "$INSTDIR\Config\ExternalPythonVersion"
  RMDir "$INSTDIR\bin"
  RMDir "$INSTDIR\Config"
    
  RMDir "$SMPROGRAMS\b3c_software\Bonemat"
  RMDir "$INSTDIR"
  ;end remove old file and directories but not the data folder
  
  SetOutPath "$INSTDIR"
  SetOverwrite ifnewer
  CreateDirectory "$INSTDIR\bin"
  SetOutPath "$INSTDIR\bin"
  File "@LHPBUILDER_EXECUTABLE_OUTPUT_PATH_WIN@\${PRODUCT_EXE_NAME}"
  File "@LHPBUILDER_EXECUTABLE_OUTPUT_PATH_WIN@\C3D_Reader.dll"
  File "@LHPBUILDER_EXECUTABLE_OUTPUT_PATH_WIN@\LicenseAurion.dll"
  CreateDirectory "$SMPROGRAMS\b3c_software\Bonemat"
  CreateShortCut "$SMPROGRAMS\b3c_software\Bonemat\Bonemat.lnk" "$INSTDIR\Bin\${PRODUCT_EXE_NAME}"
  CreateShortCut "$SMPROGRAMS\b3c_software\Bonemat\uninstall.lnk" "$INSTDIR\uninst.exe"
  CreateShortCut "$DESKTOP\Bonemat.lnk" "$INSTDIR\Bin\${PRODUCT_EXE_NAME}"
  ; is this needed? commented for the moment...
  ; File "@LHPBUILDER_EXECUTABLE_OUTPUT_PATH_WIN@\${PRODUCT_EXE_NAME}.manifest"
  CreateDirectory "$INSTDIR\Splash"
  SetOutPath "$INSTDIR\Splash"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\BonematSplash.bmp"
  CreateDirectory "$INSTDIR\Config"
  CreateDirectory "$INSTDIR\data"
  CreateDirectory "$INSTDIR\data\external"
  CreateDirectory "$INSTDIR\data\msf"
  CreateDirectory "$INSTDIR\Config\Dictionary"
  CreateDirectory "$INSTDIR\Config\ExternalPythonVersion"
  CreateDirectory "$INSTDIR\Layout"
  SetOutPath "$INSTDIR\Config\Dictionary"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\dictionary.dic"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\dicom3.dic"
  SetOutPath "$INSTDIR\Config\ExternalPythonVersion"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\PythonControl.bat"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\PythonScriptVersion.py"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\updatePythonVersion.py"
  SetOutPath "$INSTDIR\Layout"
  File "@LHPBUILDER_INSTALLER_DIR_WIN@\layout.mly"
  
  ; vme uploader downloader stuff: for the moment this is dependent on @LHPBUILDER_INSTALLER_DIR_WIN@...
  ; should we create another variable and put it in cmake GUI?  
  CreateDirectory "$INSTDIR\ASCIIParser"
  SetOutPath "$INSTDIR\ASCIIParser"
  File /R  "@LHPBUILDER_INSTALLER_DIR_WIN@\..\ASCIIParser\"

  CreateDirectory "$INSTDIR\CDBParser"
  SetOutPath "$INSTDIR\CDBParser"
  File /R  "@LHPBUILDER_INSTALLER_DIR_WIN@\..\CDBParser\"
  
  ; ASCII parser stuff: for the moment this is dependent on @LHPBUILDER_INSTALLER_DIR_WIN@...
  ; should we create another variable and put it in cmake GUI?  
  CreateDirectory "$INSTDIR\VMEUploaderDownloader"
  SetOutPath "$INSTDIR\VMEUploaderDownloader"
  File /R  "@LHPBUILDER_INSTALLER_DIR_WIN@\..\VMEUploaderDownloader\"

  
  ;Fat Installer with Python and WxPython   
  !ifdef _BUILD_FAT_INSTALLER_ON
  
  ; copy Python stuff to target installation dir     
  CreateDirectory "$INSTDIR\Python"
  SetOutPath "$INSTDIR\Python"
  File /R  "@LHPBUILDER_INSTALLER_DIR_WIN@\..\Python\"
  
  ; install python and wxPython in Python/Python25 folder
  SetOutPath "$INSTDIR\Python"
  
  ExecWait "installpy.bat $INSTDIR\Python\Python25" $0
  ExecWait "installwx.bat $INSTDIR\Python\Python25\Lib\site-packages\" $0
  
  !endif
 
  !ifdef _BUILD_FAT_INSTALLER_OFF 
  ;Slim installer: Python should be on the client machine   
    
  ;message if python is not installed
  SetOutPath "$INSTDIR\Config\ExternalPythonVersion"
  ExecWait "PythonControl.bat" $0
  
  ${If} $0 != "0"
    MessageBox MB_OK "Python not present, several application features don't work correctly"
    ExecShell "open" "http://www.python.org/download/releases/2.5.1/"
  ${EndIf}

  IfFileExists "pythonVersion.txt" PythonExists PythonNOTExists
  PythonNOTExists:
     MessageBox MB_OK "Python 2.5 not installed or directory not present in PATH variable, several application features don't work correctly"
     ExecShell "open" "http://www.python.org/download/releases/2.5.1/"
     Delete "pythonVersion.txt"
  PythonExists:

  ;must replicate control otherwise it's not deleted
  IfFileExists "$INSTDIR\Config\ExternalPythonVersion\pythonVersion.txt" Exists NOTExists
  Exists:
     Delete "$INSTDIR\Config\ExternalPythonVersion\pythonVersion.txt"
  NOTExists:
  
  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  ;security stuff
  CreateDirectory "$INSTDIR\Security"
  SetOutPath "$INSTDIR\Security"
  File /R  "@LHPBUILDER_INSTALLER_DIR_WIN@\..\Security\"
  
  ;Check for security stuff dependencies
  SetOutPath "$INSTDIR\Security\keyczar"
  ExecWait '"python.exe" CheckKeyczarDependencies.py' $0
  
  ${If} $0  != "0"
    MessageBox MB_OK  "Problems installing security libraries: please check that you have sufficient privileges to write \
    in Python installation directory. \
    Several application features will not work correctly. A web page showing all dependencies needed for security stuff \
    will open when you press OK. Since this error is non fatal installation process will continue."   
    ExecShell "open" "http://code.google.com/p/keyczar/wiki/PythonDependencies"
  ${EndIf}
  
  ; end security stuff
  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;v
    
  !endif
  
  SetOutPath "$INSTDIR\bin"
SectionEnd

Function CheckIfApplicationIsAlreadyInstalled
; check if the program already exist

!insertmacro IfKeyExists HKEY_CURRENT_USER "Software" "Bonemat"
Pop $R0
IntCmp $R0 1 registry_key_present registry_key_not_found
registry_key_present:
;      MessageBox MB_OK "registry key found"
  ;    Abort
     ;MessageBox MB_OK "Application already installed! Please uninstall it before performing a new installation."
     ;Abort
registry_key_not_found:
    ;MessageBox MB_OK "registry key not found"   
;      Abort

FunctionEnd

Function .onInit
  Call CheckIfApplicationIsAlreadyInstalled
FunctionEnd


Section -AdditionalIcons
  WriteIniStr "$INSTDIR\${PRODUCT_NAME}.url" "InternetShortcut" "URL" "${PRODUCT_WEB_SITE}"
  CreateShortCut "$SMPROGRAMS\b3c_software\LHPBuilder\Website.lnk" "$INSTDIR\${PRODUCT_NAME}.url"
  CreateShortCut "$SMPROGRAMS\b3c_software\LHPBuilder\Uninstall.lnk" "$INSTDIR\uninst.exe"
SectionEnd

Section -Post
  WriteUninstaller "$INSTDIR\uninst.exe"
  WriteRegStr HKCU "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayName" "$(^Name)"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\uninst.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "$INSTDIR\Bin\${PRODUCT_EXE_NAME}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "URLInfoAbout" "${PRODUCT_WEB_SITE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
SectionEnd


Function un.onUninstSuccess
  HideWindow
  MessageBox MB_ICONINFORMATION|MB_OK "$(^Name) has been completely removed from your computer."
FunctionEnd

Function un.onInit
  MessageBox MB_ICONQUESTION|MB_YESNO|MB_DEFBUTTON2 "Are you sure you want to completely remove $(^Name) and all its components?" IDYES +2
  Abort
FunctionEnd

Section Uninstall
  Delete "$INSTDIR\${PRODUCT_NAME}.url"
  Delete "$INSTDIR\uninst.exe"
  Delete "$INSTDIR\Bin\${PRODUCT_EXE_NAME}.manifest"
  Delete "$INSTDIR\Bin\${PRODUCT_EXE_NAME}"

  Delete "$INSTDIR\bin\C3D_Reader.dll"
  Delete "$INSTDIR\bin\LicenseAurion.dll"

  Delete "$INSTDIR\Layout\layout.mly"
  Delete "$INSTDIR\Config\Dictionary\dictionary.dic"
  Delete "$INSTDIR\Config\Dictionary\dicom3.dic"
  Delete "$INSTDIR\Splash\BonematSplash.bmp"
  
  !ifdef _BUILD_FAT_INSTALLER_ON
  IfFileExists "$INSTDIR\Python\Python25\python.exe" uninstall skipUninstall
  
  uninstall:
  ExecWait "uninstallwx.bat $INSTDIR\Python\Python25" $0
  ExecWait "uninstallpy.bat $INSTDIR\Python\Python25" $0
  
  skipUninstall:
  !endif
  
  Delete "$INSTDIR\Config\ExternalPythonVersion\PythonControl.bat"
  Delete "$INSTDIR\Config\ExternalPythonVersion\PythonScriptVersion.py"
  Delete "$INSTDIR\Config\ExternalPythonVersion\updatePythonVersion.py"

  IfFileExists "$INSTDIR\Config\ExternalPythonVersion\updatePythonVersion.pyc" Exists NOTExists
  Exists:
     Delete "$INSTDIR\Config\ExternalPythonVersion\updatePythonVersion.pyc"

  NOTExists:

  Delete "$SMPROGRAMS\b3c_software\Bonemat\Uninstall.lnk"
  Delete "$SMPROGRAMS\b3c_software\Bonemat\Website.lnk"
  Delete "$DESKTOP\Bonemat.lnk"
  Delete "$SMPROGRAMS\b3c_software\Bonemat\Bonemat.lnk"

  RMDir /R "$INSTDIR\VMEUploaderDownloader"
  RMDir /R "$INSTDIR\ASCIIParser"
  RMDir /R "$INSTDIR\CDBParser"
  RMDir "$INSTDIR\Splash"
  RMDir "$INSTDIR\Layout"
  RMDir "$INSTDIR\Config\Dictionary"
  RMDir "$INSTDIR\Config\ExternalPythonVersion"
  RMDir "$INSTDIR\bin"
  RMDir "$INSTDIR\data\external"
  RMDir "$INSTDIR\data\msf"
  RMDir "$INSTDIR\data"
  RMDir "$INSTDIR\Config"
    
  RMDir "$SMPROGRAMS\b3c_software\Bonemat"
  RMDir "$INSTDIR"

  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKCU "${PRODUCT_DIR_REGKEY}"
  DeleteRegKey HKCU "Software\Bonemat"
  DeleteRegKey /ifempty HKCU "Software\B3C\${PRODUCT_NAME}"
  
  SetAutoClose true
SectionEnd