#pragma once

#if @MAF_BUILD_MAFDLL@
# define MAF_SHARED
// # define MAF_EXPORTS
#endif

//--------------------------------------------------------------------------
// Disable some annoying warning message
//--------------------------------------------------------------------------
#if defined(_MSC_VER) && defined(MAF_SHARED)
# pragma warning ( disable : 4275 )
#endif

#if defined(_MSC_VER)
# pragma warning ( disable : 4786 )
#endif

//--------------------------------------------------------------------------
// For WIN32 dynamic linking
//--------------------------------------------------------------------------
#if defined(_WIN32) && defined(MAF_SHARED)
# if defined(MAF_EXPORTS)
#  define MAF_EXPORT __declspec( dllexport ) 
# else
#  define MAF_EXPORT __declspec( dllimport ) 
# endif
#else
#define FTK_BASE_EXPORT
#define FTK_CORE_EXPORT
#define FTK_GUI_EXPORT
#define FTK_IO_EXPORT
#define FTK_INTERACTION_EXPORT
#define FTK_VME_EXPORT
#define FTK_OPERATION_EXPORT
#define FTK_VIEW_EXPORT
#define MAF_EXPORT
#define MED_COMMON_EXPORT
#define MED_GUI_EXPORT
#define MED_VME_EXPORT
#define MED_INTERACTION_EXPORT
#define MED_OPERATION_EXPORT
#define MED_VIEWS_EXPORT
#endif

//--------------------------------------------------------------------------
// Which libraries MAF is linking
//--------------------------------------------------------------------------
#cmakedefine MAF_USE_VTK
#cmakedefine MAF_USE_WX
#cmakedefine MAF_USE_ITK
#cmakedefine MAF_USE_CRYPTO
#cmakedefine MAF_USE_CURL
#cmakedefine MAF_USE_WXMOZILLA

//--------------------------------------------------------------------------
// MAF Versioning
//--------------------------------------------------------------------------

#define FTK_MAJOR_VERSION @FTK_VERSION_MAJOR@
#define FTK_MINOR_VERSION @FTK_VERSION_MINOR@
#define FTK_BUILD_VERSION @FTK_VERSION_PATCH@
#define FTK_VERSION "@FTK_VERSION@"

//--------------------------------------------------------------------------
// Which threading system are we using
//--------------------------------------------------------------------------
#cmakedefine CMAKE_USE_PTHREADS_INIT
#cmakedefine CMAKE_USE_SPROC_INIT
#cmakedefine CMAKE_HP_PTHREADS_INIT
#cmakedefine CMAKE_USE_WIN32_THREADS_INIT

//--------------------------------------------------------------------------
// Data root used to reach data for testing
//--------------------------------------------------------------------------
#define MAF_DATA_ROOT "@MAF_DATA_ROOT@"
#define MED_DATA_ROOT "@MED_DATA_ROOT@"
#define LHP_DATA_ROOT "@LHP_DATA_ROOT@"

#define LHP_SOURCE_DIR "@LHP_SOURCE_DIR@"

#cmakedefine MAF_USE_BTK

#define BEGIN_FTK_NAMESPACE
#define END_FTK_NAMESPACE
